{
 "title": "All Servers",
 "uid": "all-servers",
 "schemaVersion": 36,
 "version": 1,
 "editable": true,
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "server",
    "label": "Сервер",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "definition": "label_values(up{job=\"node\"}, instance)",
    "query": {
     "qryType": 1,
     "query": "label_values(up{job=\"node\"}, instance)",
     "refId": "PrometheusVariableQueryEditor-VariableQuery"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": "$__all"
    },
    "options": [],
    "regex": "",
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "marcusolsson-dynamictext-panel",
   "title": "Статус серверов",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "(up{job=\"node\"} * on(instance) group_left(nodename) node_uname_info{job=\"node\"}) or up{job=~\"blikvm.*\"}",
     "instant": true,
     "refId": "A",
     "format": "table"
    }
   ],
   "options": {
    "content": "<style>\n*:has(> .dt-row){display:flex !important;flex-direction:row !important;flex-wrap:wrap !important;gap:4px !important;align-items:stretch !important}\n.dt-row{box-sizing:border-box;flex:1 1 150px;min-width:148px;max-width:300px;border-radius:6px;padding:8px;min-height:68px}\n.dt-row:has(> .c.ok){background:#2f9e44}\n.dt-row:has(> .c.bad){background:#c92a2a}\n.nm{font-size:15px;font-weight:600;color:#fff;line-height:1.3;margin-bottom:8px;word-break:break-word}\n.st{font-size:20px;font-weight:700;color:#fff}\n</style>\n<div class=\"c {{#if Value}}ok{{else}}bad{{/if}}\">\n<div class=\"nm\">{{club}}{{location_type}}{{kvm}} {{instance}}{{#if nodename}} &middot; {{nodename}}{{/if}}</div>\n<div class=\"st\">{{#if Value}}&#9679; ONLINE{{else}}&#9760; OFFLINE{{/if}}</div>\n</div>",
    "everyRow": true,
    "defaultContent": "нет данных"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "CPU Usage %",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$server\"}[5m])) * 100)",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "RAM Usage %",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$server\"} / node_memory_MemTotal_bytes{instance=~\"$server\"})",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Disk Usage %",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "expr": "100 * (1 - node_filesystem_avail_bytes{instance=~\"$server\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{instance=~\"$server\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Network Traffic",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 13
   },
   "targets": [
    {
     "expr": "rate(node_network_receive_bytes_total{instance=~\"$server\",device=~\"eno.*|eth.*|ens.*\"}[5m]) + rate(node_network_transmit_bytes_total{instance=~\"$server\",device=~\"eno.*|eth.*|ens.*\"}[5m])",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Disk I/O Read",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 21
   },
   "targets": [
    {
     "expr": "rate(node_disk_read_bytes_total{instance=~\"$server\"}[5m])",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Disk I/O Write",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 21
   },
   "targets": [
    {
     "expr": "rate(node_disk_written_bytes_total{instance=~\"$server\"}[5m])",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "BliKVM: Температура, °C",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 29
   },
   "targets": [
    {
     "expr": "blikvm_temperature_c",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "min": 0,
     "max": 80
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "BliKVM: Доступно памяти",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 29
   },
   "targets": [
    {
     "expr": "blikvm_mem_available_bytes",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "stat",
   "title": "BliKVM: Статус",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 37
   },
   "targets": [
    {
     "expr": "up{job=~\"blikvm.*\"}",
     "instant": true,
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 11,
   "type": "stat",
   "title": "SSD/NVMe: статус SMART",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 45
   },
   "targets": [
    {
     "expr": "smartctl_device_smart_status",
     "instant": true,
     "refId": "A",
     "legendFormat": "{{instance}} {{device}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "SSD/NVMe: температура, °C",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 8,
    "y": 45
   },
   "targets": [
    {
     "expr": "smartctl_device_temperature{temperature_type=\"current\"}",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "min": 0,
     "max": 80
    },
    "overrides": []
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "NVMe: износ, %",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 16,
    "y": 45
   },
   "targets": [
    {
     "expr": "smartctl_device_percentage_used",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   }
  },
  {
   "id": 14,
   "type": "table",
   "title": "Службы failed (1С/СКУД/прочие) — пусто = все службы живы",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 51
   },
   "targets": [
    {
     "expr": "node_systemd_unit_state{name!=\"\",state=\"failed\"} == 1",
     "instant": true,
     "refId": "A",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 15,
   "type": "table",
   "title": "🔐 Подбор паролей SSH (24ч) — пусто = тихо",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 57
   },
   "targets": [
    {
     "expr": "sum by (instance, ip, user) (increase(ssh_failed_logins_total[24h])) > 0",
     "instant": true,
     "refId": "A",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 16,
   "type": "table",
   "title": "🔐 SSH входы (24ч) — кто и откуда заходил",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 57
   },
   "targets": [
    {
     "expr": "sum by (instance, user, ip) (increase(ssh_success_logins_total[24h])) > 0",
     "instant": true,
     "refId": "A",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  }
 ]
}